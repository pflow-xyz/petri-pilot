load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "zk-tictactoe",
    srcs = [
        "circuits.go",
        "game.go",
        "graphql.go",
        "integration.go",
        "petri_circuits.go",
        "petri_game.go",
        "petri_state.go",
        "service.go",
        "state.go",
        "zkservice.go",
    ],
    importpath = "github.com/pflow-xyz/petri-pilot/zk-tictactoe",
    visibility = ["//visibility:public"],
    deps = [
        "//examples/tictactoe",
        "//pkg/serve",
        "@com_github_consensys_gnark//frontend",
        "@com_github_consensys_gnark//std/hash/mimc",
        "@com_github_consensys_gnark_crypto//ecc/bn254/fr",
        "@com_github_consensys_gnark_crypto//ecc/bn254/fr/mimc",
        "@com_github_pflow_xyz_go_pflow//prover",
    ],
)

go_test(
    name = "zk-tictactoe_test",
    srcs = [
        "circuits_test.go",
        "e2e_test.go",
        "graphql_test.go",
        "petri_circuits_test.go",
    ],
    embed = [":zk-tictactoe"],
    deps = [
        "@com_github_consensys_gnark//frontend",
        "@com_github_consensys_gnark//frontend/cs/r1cs",
        "@com_github_consensys_gnark//test",
        "@com_github_consensys_gnark_crypto//ecc",
    ],
)
