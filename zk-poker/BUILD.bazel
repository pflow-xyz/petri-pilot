load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "zk-poker",
    srcs = [
        "action_circuit.go",
        "circuits.go",
        "graphql.go",
        "hand_eval.go",
        "showdown_circuit.go",
        "state.go",
        "topology.go",
    ],
    importpath = "github.com/pflow-xyz/petri-pilot/zk-poker",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/serve",
        "@com_github_consensys_gnark//frontend",
