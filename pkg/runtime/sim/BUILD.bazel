load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "sim",
    srcs = [
        "http.go",
        "scenario.go",
        "sim.go",
    ],
    importpath = "github.com/pflow-xyz/petri-pilot/pkg/runtime/sim",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/dsl",
        "//pkg/runtime/api",
        "@com_github_pflow_xyz_go_pflow//metamodel",
        "@com_github_pflow_xyz_go_pflow//stochastic",
    ],
)

go_test(
    name = "sim_test",
    srcs = [
        "cafe_e2e_test.go",
        "cafe_fitness_test.go",
        "cafe_service_test.go",
        "gating_test.go",
        "golden_test.go",
        "http_smoke_test.go",
        "metrics_test.go",
        "scenario_test.go",
        "supply_test.go",
        "vetclinic_fitness_test.go",
    ],
    # The vet-clinic fitness gates read ../../../services/vet-clinic.json from
    # disk; supply it as a data runfile so the test is hermetic.
    # golden_test.go reads services/coffeeshop.json the same way and compares
    # against the pre-move goldens under testdata/.
    data = [
        "//services:coffeeshop.json",
        "//services:vet-clinic.json",
    ] + glob(["testdata/**"]),  # keep
    embed = [":sim"],
    deps = [
        "//generated",
        "//generated/beancounter",
        "//generated/cafe",
        "//pkg/serve",
        "@com_github_pflow_xyz_go_pflow//eventsource",
        "@com_github_pflow_xyz_go_pflow//metamodel",
    ],
)
