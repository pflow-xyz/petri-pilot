"""{{.ModelName}}: pure-Bazel (Bzlmod) build, generated by petri-pilot.

Dependencies are sourced from go.mod via Gazelle's go_deps extension, so
`go build`/`go test` keep working alongside Bazel. Run `bazel mod tidy` after
editing go.mod to reconcile the use_repo list below.
"""

module(
    name = "{{.Bazel.ModuleName}}",
    version = "0.0.0",
)

bazel_dep(name = "rules_go", version = "0.61.1", repo_name = "io_bazel_rules_go")
bazel_dep(name = "gazelle", version = "0.51.3", repo_name = "bazel_gazelle")

# Hermetic Go SDK (>= the go.mod toolchain). nogo runs static analysis at build time.
go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "{{.Bazel.GoSDKVersion}}")
go_sdk.nogo(nogo = "//:nogo")

# External Go deps come straight from go.mod / go.sum.
go_deps = use_extension("@bazel_gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

# `bazel mod tidy` reconciles this list with the go.mod graph.
use_repo(
    go_deps,
{{- range .Bazel.UseRepos}}
    "{{.}}",
{{- end}}
)
