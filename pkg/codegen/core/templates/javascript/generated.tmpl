function initialMarking() {
    return {
{{- range .Places}}
        '{{.Name}}': {{.Initial}},
{{- end}}
    };
}

// Canonical marking form: marked places sorted by name, comma-joined,
// ":count" appended when a place holds more than one token.
function render(marking) {
    return Object.keys(marking)
        .filter((name) => marking[name] > 0)
        .sort()
        .map((name) => (marking[name] > 1 ? `${name}:${marking[name]}` : name))
        .join(',');
}
{{range .Transitions}}
// Fires {{.Name}} if enabled and reports whether it did.
function fire{{camel .Name}}(marking) {
{{- range .Inputs}}
    if (marking['{{.Place}}'] < {{.Weight}}) {
        return false;
    }
{{- end}}
{{- range .Reads}}
    if (marking['{{.Place}}'] < {{.Weight}}) {
        return false; // read arc: required, not consumed
    }
{{- end}}
{{- range .Inhibits}}
    if (marking['{{.Place}}'] >= {{.Weight}}) {
        return false; // inhibitor
    }
{{- end}}
{{- range .Outputs}}
{{- if gt .Capacity 0}}
    if (marking['{{.Place}}'] + {{.Weight}} > {{.Capacity}}) {
        return false; // capacity {{.Capacity}}
    }
{{- end}}
{{- end}}
{{- range .Inputs}}
    marking['{{.Place}}'] -= {{.Weight}};
{{- end}}
{{- range .Outputs}}
    marking['{{.Place}}'] += {{.Weight}};
{{- end}}
    return true;
}
{{end}}
// Transitions in sorted order with their fire functions.
const SCHEDULE = [
{{- range .Transitions}}
    ['{{.Name}}', fire{{camel .Name}}],
{{- end}}
];

function main() {
    const marking = initialMarking();
    let step = 0;
    for (;;) {
        let fired = false;
        for (const [name, fire] of SCHEDULE) {
            if (fire(marking)) {
                step++;
                console.log(`Step #${step}: ${name} => ${render(marking)}`);
                fired = true;
                break;
            }
        }
        if (!fired) {
            return;
        }
    }
}

if (typeof require !== 'undefined' && require.main === module) {
