// Code generated by petri-pilot (core mode, interpreter form); DO NOT EDIT.
//
// Interpreter form for the "{{.Name}}" model: the net is runtime data — a
// table of transitions with their arc lists — walked by one generic
// enablement/firing engine. Nothing about this model is compiled into
// control flow; swap the tables and the engine runs a different net.
//
// Everything above main() embeds cleanly; main() is a demo driver that fires
// the first enabled transition (in sorted order) until none is, printing one
// line per firing.

// The net as data. Arcs are {place, weight} objects; output arcs carry the
// place's capacity (0 = unbounded).
const TRANSITIONS = [
{{- range .Transitions}}
    {
        name: '{{.Name}}',
        inputs: [{{range .Inputs}}{ place: '{{.Place}}', weight: {{.Weight}} }, {{end}}],
        outputs: [{{range .Outputs}}{ place: '{{.Place}}', weight: {{.Weight}}, capacity: {{.Capacity}} }, {{end}}],
        reads: [{{range .Reads}}{ place: '{{.Place}}', weight: {{.Weight}} }, {{end}}],
        inhibits: [{{range .Inhibits}}{ place: '{{.Place}}', weight: {{.Weight}} }, {{end}}],
    },
{{- end}}
];

function initialMarking() {
    return {
{{- range .Places}}
        '{{.Name}}': {{.Initial}},
{{- end}}
    };
}

// The one generic enablement rule, applied to the data above.
function enabled(marking, t) {
    return t.inputs.every((a) => marking[a.place] >= a.weight)
        && t.reads.every((a) => marking[a.place] >= a.weight)
        && t.inhibits.every((a) => marking[a.place] < a.weight)
        && t.outputs.every((a) => a.capacity === 0 || marking[a.place] + a.weight <= a.capacity);
}

// Fires t if enabled and reports whether it did.
function fire(marking, t) {
    if (!enabled(marking, t)) {
        return false;
    }
    for (const a of t.inputs) {
        marking[a.place] -= a.weight;
    }
    for (const a of t.outputs) {
        marking[a.place] += a.weight;
    }
    return true;
}

// Canonical marking form: marked places sorted by name, comma-joined,
// ":count" appended when a place holds more than one token.
function render(marking) {
    return Object.keys(marking)
        .filter((name) => marking[name] > 0)
        .sort()
        .map((name) => (marking[name] > 1 ? `${name}:${marking[name]}` : name))
        .join(',');
}

function main() {
    const marking = initialMarking();
    let step = 0;
    for (;;) {
        let fired = false;
        for (const t of TRANSITIONS) {
            if (fire(marking, t)) {
                step++;
                console.log(`Step #${step}: ${t.name} => ${render(marking)}`);
                fired = true;
                break;
            }
        }
        if (!fired) {
            return;
        }
    }
}

if (typeof require !== 'undefined' && require.main === module) {
    main();
}

if (typeof module !== 'undefined') {
    module.exports = { TRANSITIONS, initialMarking, enabled, fire, render, main };
}
