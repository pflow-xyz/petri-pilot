{{define "main" -}}
// Code generated by petri-pilot (core mode, lambda form); DO NOT EDIT.
//
// Lambda form for the "{{.Name}}" model: each transition is a pure
// marking -> marking-or-null function carrying its own precondition; there
// is no arc table and no generic engine. The schedule is a fixed list the
// driver folds over — no search decides the order.
//
// Purity is by copy: a transition that refuses returns null and the input is
// untouched; a transition that fires returns a fresh object.
//
// Everything above main() embeds cleanly; main() is a demo driver that
// applies the first firing function per round until a round fires nothing,
// printing one line per firing.

function initialMarking() {
    return {
{{- range .Places}}
        '{{.Name}}': {{.Initial}},
{{- end}}
    };
}
{{range .Transitions}}
// Fires {{.Name}}: a pure function returning the next marking, or null.
function {{lowerFirst .Name}}(marking) {
{{- range .Inputs}}
    if (marking['{{.Place}}'] < {{.Weight}}) {
        return null;
    }
{{- end}}
{{- range .Reads}}
    if (marking['{{.Place}}'] < {{.Weight}}) {
        return null; // read arc: required, not consumed
    }
{{- end}}
{{- range .Inhibits}}
    if (marking['{{.Place}}'] >= {{.Weight}}) {
        return null; // inhibitor
    }
{{- end}}
{{- range .Outputs}}
{{- if gt .Capacity 0}}
    if (marking['{{.Place}}'] + {{.Weight}} > {{.Capacity}}) {
        return null; // capacity {{.Capacity}}
    }
{{- end}}
{{- end}}
    const next = { ...marking };
{{- range .Inputs}}
    next['{{.Place}}'] -= {{.Weight}};
{{- end}}
{{- range .Outputs}}
    next['{{.Place}}'] += {{.Weight}};
{{- end}}
    return next;
}
{{end}}
// The fixed composition order.
const SCHEDULE = [
{{- range .Transitions}}
    ['{{.Name}}', {{lowerFirst .Name}}],
{{- end}}
];

// Canonical marking form: marked places sorted by name, comma-joined,
// ":count" appended when a place holds more than one token.
function render(marking) {
    return Object.keys(marking)
        .filter((name) => marking[name] > 0)
        .sort()
        .map((name) => (marking[name] > 1 ? `${name}:${marking[name]}` : name))
        .join(',');
}

function main() {
    let marking = initialMarking();
    let step = 0;
    for (;;) {
        let fired = false;
        for (const [name, transition] of SCHEDULE) {
            const next = transition(marking);
            if (next !== null) {
                marking = next;
                step++;
                console.log(`Step #${step}: ${name} => ${render(marking)}`);
                fired = true;
                break;
            }
        }
        if (!fired) {
            return;
        }
    }
}

if (typeof require !== 'undefined' && require.main === module) {
    main();
}

if (typeof module !== 'undefined') {
    module.exports = { initialMarking, SCHEDULE, render, main };
}
{{end}}
