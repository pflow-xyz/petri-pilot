// Code generated by petri-pilot (core mode, contract form); DO NOT EDIT.
//
// Contract form for the "{{.Name}}" model: the net is a public API surface.
// There is no scheduler inside the machine — each transition is an entry
// point that either fires (appending to the event log) or returns an error
// string naming why it refused (null means it fired). The caller owns
// sequencing; calling entry points in any order is safe, because a refused
// call changes nothing.
//
// Everything above main() embeds cleanly; main() is a demo driver playing
// the caller: it retries the entry points (in sorted order) until none
// fires, printing one line per firing.

// The marking plus the log of fired transitions.
class Machine {
    constructor() {
        this.marked = {
{{- range .Places}}
            '{{.Name}}': {{.Initial}},
{{- end}}
        };
        this.events = [];
    }

    // The contract's view function: marked places sorted by name,
    // comma-joined, ":count" appended when a place holds more than one
    // token.
    marking() {
        return Object.keys(this.marked)
            .filter((name) => this.marked[name] > 0)
            .sort()
            .map((name) => (this.marked[name] > 1 ? `${name}:${this.marked[name]}` : name))
            .join(',');
    }
{{range $t := .Transitions}}
    // Fires {{.Name}}; returns null on success or a reason string when not
    // enabled. A refused call leaves the machine untouched.
    {{lowerFirst .Name}}() {
{{- range .Inputs}}
        if (this.marked['{{.Place}}'] < {{.Weight}}) {
            return '{{$t.Name}}: missing input {{.Place}}';
        }
{{- end}}
{{- range .Reads}}
        if (this.marked['{{.Place}}'] < {{.Weight}}) {
            return '{{$t.Name}}: guard unsatisfied {{.Place}}';
        }
{{- end}}
{{- range .Inhibits}}
        if (this.marked['{{.Place}}'] >= {{.Weight}}) {
            return '{{$t.Name}}: inhibited by {{.Place}}';
        }
{{- end}}
{{- range .Outputs}}
{{- if gt .Capacity 0}}
        if (this.marked['{{.Place}}'] + {{.Weight}} > {{.Capacity}}) {
            return '{{$t.Name}}: capacity exceeded at {{.Place}}';
        }
{{- end}}
{{- end}}
{{- range .Inputs}}
        this.marked['{{.Place}}'] -= {{.Weight}};
{{- end}}
{{- range .Outputs}}
        this.marked['{{.Place}}'] += {{.Weight}};
{{- end}}
        this.events.push('{{$t.Name}}');
        return null;
    }
{{end -}}
}

function main() {
    const machine = new Machine();
    const calls = [
{{- range .Transitions}}
        ['{{.Name}}', () => machine.{{lowerFirst .Name}}()],
{{- end}}
    ];
    let step = 0;
    for (;;) {
        let fired = false;
        for (const [name, call] of calls) {
            if (call() === null) {
                step++;
                console.log(`Step #${step}: ${name} => ${machine.marking()}`);
                fired = true;
                break;
            }
        }
        if (!fired) {
            return;
        }
    }
}

if (typeof require !== 'undefined' && require.main === module) {
    main();
}

if (typeof module !== 'undefined') {
    module.exports = { Machine, main };
}
