{{define "main" -}}
# Code generated by petri-pilot (core mode, interpreter form); DO NOT EDIT.
#
# Interpreter form for the "{{.Name}}" model: the net is runtime data — a
# table of transitions with their arc lists — walked by one generic
# enablement/firing engine. Nothing about this model is compiled into
# control flow; swap the tables and the engine runs a different net.
#
# Everything above main() embeds cleanly; main() is a demo driver that fires
# the first enabled transition (in sorted order) until none is, printing one
# line per firing.

# The net as data. Arcs are (place, weight) pairs; output arcs carry the
# place's capacity as a third element (0 = unbounded).
TRANSITIONS = [
{{- range .Transitions}}
    {
        "name": "{{.Name}}",
        "inputs": [{{range .Inputs}}("{{.Place}}", {{.Weight}}), {{end}}],
        "outputs": [{{range .Outputs}}("{{.Place}}", {{.Weight}}, {{.Capacity}}), {{end}}],
        "reads": [{{range .Reads}}("{{.Place}}", {{.Weight}}), {{end}}],
        "inhibits": [{{range .Inhibits}}("{{.Place}}", {{.Weight}}), {{end}}],
    },
{{- end}}
]


def initial_marking():
    """The model's initial marking: a token count per place."""
    return {
{{- range .Places}}
        "{{.Name}}": {{.Initial}},
{{- end}}
    }


def enabled(marking, transition):
    """The one generic enablement rule, applied to the data above."""
    return (
        all(marking[p] >= w for p, w in transition["inputs"])
        and all(marking[p] >= w for p, w in transition["reads"])
        and all(marking[p] < w for p, w in transition["inhibits"])
        and all(cap == 0 or marking[p] + w <= cap for p, w, cap in transition["outputs"])
    )


def fire(marking, transition):
    """Fires the transition if enabled and reports whether it did."""
    if not enabled(marking, transition):
        return False
    for p, w in transition["inputs"]:
        marking[p] -= w
    for p, w, _ in transition["outputs"]:
        marking[p] += w
    return True


def render(marking):
    """Canonical marking form: marked places sorted by name, comma-joined,
    ":count" appended when a place holds more than one token."""
    parts = []
    for name in sorted(marking):
        count = marking[name]
        if count > 1:
            parts.append(f"{name}:{count}")
        elif count > 0:
            parts.append(name)
    return ",".join(parts)


def main():
    marking = initial_marking()
    step = 0
    while True:
        for transition in TRANSITIONS:
            if fire(marking, transition):
                step += 1
                print(f"Step #{step}: {transition['name']} => {render(marking)}")
                break
        else:
            return


if __name__ == "__main__":
    main()
