{{define "main" -}}
# Code generated by petri-pilot (core mode, lambda form); DO NOT EDIT.
#
# Lambda form for the "{{.Name}}" model: each transition is a pure
# marking -> marking-or-None function carrying its own precondition; there is
# no arc table and no generic engine. The schedule is a fixed list the driver
# folds over — no search decides the order.
#
# Purity is by copy: a transition that refuses returns None and the input is
# untouched; a transition that fires returns a fresh dict.
#
# Everything above main() embeds cleanly; main() is a demo driver that
# applies the first firing function per round until a round fires nothing,
# printing one line per firing.


def initial_marking():
    """The model's initial marking: a token count per place."""
    return {
{{- range .Places}}
        "{{.Name}}": {{.Initial}},
{{- end}}
    }

{{range .Transitions}}
def {{snake .Name}}(marking):
    """Fires {{.Name}}: a pure function returning the next marking, or None."""
{{- range .Inputs}}
    if marking["{{.Place}}"] < {{.Weight}}:
        return None
{{- end}}
{{- range .Reads}}
    if marking["{{.Place}}"] < {{.Weight}}:
        return None  # read arc: required, not consumed
{{- end}}
{{- range .Inhibits}}
    if marking["{{.Place}}"] >= {{.Weight}}:
        return None  # inhibitor
{{- end}}
{{- range .Outputs}}
{{- if gt .Capacity 0}}
    if marking["{{.Place}}"] + {{.Weight}} > {{.Capacity}}:
        return None  # capacity {{.Capacity}}
{{- end}}
{{- end}}
    next_marking = dict(marking)
{{- range .Inputs}}
    next_marking["{{.Place}}"] -= {{.Weight}}
{{- end}}
{{- range .Outputs}}
    next_marking["{{.Place}}"] += {{.Weight}}
{{- end}}
    return next_marking

{{end}}
# The fixed composition order.
SCHEDULE = [
{{- range .Transitions}}
    ("{{.Name}}", {{snake .Name}}),
{{- end}}
]


def render(marking):
    """Canonical marking form: marked places sorted by name, comma-joined,
    ":count" appended when a place holds more than one token."""
    parts = []
    for name in sorted(marking):
        count = marking[name]
        if count > 1:
            parts.append(f"{name}:{count}")
        elif count > 0:
            parts.append(name)
    return ",".join(parts)


def main():
    marking = initial_marking()
    step = 0
    while True:
        for name, transition in SCHEDULE:
            next_marking = transition(marking)
            if next_marking is not None:
                marking = next_marking
                step += 1
                print(f"Step #{step}: {name} => {render(marking)}")
                break
        else:
            return


if __name__ == "__main__":
    main()
{{end}}
