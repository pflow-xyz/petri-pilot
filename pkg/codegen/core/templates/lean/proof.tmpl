{{define "main" -}}
-- Code generated by petri-pilot (core mode, proof form); DO NOT EDIT.
--
-- Proof form for the "{{.Name}}" model. At generation time, petri-pilot's
-- Go analyzer explored this net's full reachable state space and found:
--
--   reachable markings : {{.Proof.StateCount}}
--   per-place bounds   : {{ints .Proof.Bounds}}
--   deadlock markings  : {{len .Proof.Deadlocks}}
--
-- The theorems below re-state those findings, and `{{.Proof.Tactic}}` makes
-- the Lean kernel re-derive every one of them by running the same
-- breadth-first search during elaboration. A wrong finding is therefore not
-- a wrong comment — it is a file that does not compile. Two independent
-- implementations (Go at generation time, Lean at compile time) must agree
-- before `main` is allowed to exist.
--
-- Semantics per transition: inputs and reads hold enough tokens, inhibitors
-- hold too few, and bounded output places have room — the same rule every
-- other core-mode form compiles in.

-- Places, sorted by name. The marking is a List Nat aligned with this list.
def placeNames : List String :=
  [{{range $i, $p := .Places}}{{if $i}}, {{end}}"{{$p.Name}}"{{end}}]

def initialMarking : List Nat :=
  [{{range $i, $p := .Places}}{{if $i}}, {{end}}{{$p.Initial}}{{end}}]

-- One transition: arcs address places by index into placeNames.
-- inputs/reads/inhibits are (index, weight); outputs are
-- (index, weight, capacity) with capacity 0 meaning unbounded.
structure Transition where
  name     : String
  inputs   : List (Nat × Nat)
  outputs  : List (Nat × Nat × Nat)
  reads    : List (Nat × Nat)
  inhibits : List (Nat × Nat)

def transitions : List Transition :=
  [
{{- range $t := .Transitions}}
    { name := "{{$t.Name}}",
      inputs := [{{range $i, $a := $t.Inputs}}{{if $i}}, {{end}}({{$.PlaceIndex $a.Place}}, {{$a.Weight}}){{end}}],
      outputs := [{{range $i, $a := $t.Outputs}}{{if $i}}, {{end}}({{$.PlaceIndex $a.Place}}, {{$a.Weight}}, {{$a.Capacity}}){{end}}],
      reads := [{{range $i, $a := $t.Reads}}{{if $i}}, {{end}}({{$.PlaceIndex $a.Place}}, {{$a.Weight}}){{end}}],
      inhibits := [{{range $i, $a := $t.Inhibits}}{{if $i}}, {{end}}({{$.PlaceIndex $a.Place}}, {{$a.Weight}}){{end}}] },
{{- end}}
  ]

def count (m : List Nat) (i : Nat) : Nat :=
  m.getD i 0

def enabled (m : List Nat) (t : Transition) : Bool :=
  t.inputs.all (fun a => count m a.1 ≥ a.2)
    && t.reads.all (fun a => count m a.1 ≥ a.2)
    && t.inhibits.all (fun a => count m a.1 < a.2)
    && t.outputs.all (fun a => a.2.2 == 0 || count m a.1 + a.2.1 ≤ a.2.2)

-- Sum of weights that `arcs` carry for place index i.
def wsum (arcs : List (Nat × Nat)) (i : Nat) : Nat :=
  (arcs.filter (fun a => a.1 == i)).foldl (fun acc a => acc + a.2) 0

def fire (m : List Nat) (t : Transition) : List Nat :=
  (List.range m.length).map fun i =>
    count m i - wsum t.inputs i + wsum (t.outputs.map (fun a => (a.1, a.2.1))) i

def successors (m : List Nat) : List (List Nat) :=
  (transitions.filter (enabled m ·)).map (fire m)

-- Breadth-first search. The fuel ({{.Proof.Fuel}}) exceeds the analyzer's
-- state count by a margin; reachable_closed below is what proves the search
-- actually finished, so the fuel is never load-bearing.
def explore : Nat → List (List Nat) → List (List Nat) → List (List Nat)
  | 0, seen, _ => seen
  | _ + 1, seen, [] => seen
  | fuel + 1, seen, m :: frontier =>
      let fresh := (successors m).filter (fun n => !seen.contains n)
      explore fuel (seen ++ fresh) (frontier ++ fresh)

def reachable : List (List Nat) :=
  explore {{.Proof.Fuel}} [initialMarking] [initialMarking]

def isDeadlock (m : List Nat) : Bool :=
  transitions.all (fun t => !enabled m t)

-- The analyzer's findings, baked in for the kernel to re-derive.

def expectedBounds : List Nat :=
  [{{ints .Proof.Bounds}}]

def expectedDeadlocks : List (List Nat) :=
  [{{range $i, $d := .Proof.Deadlocks}}{{if $i}}, {{end}}[{{ints $d}}]{{end}}]

-- The BFS closed: every successor of a reachable marking was reached, so
-- every theorem below quantifies over the whole state space, not a
-- fuel-truncated prefix of it.
theorem reachable_closed :
    reachable.all (fun m => (successors m).all (reachable.contains ·)) = true := by
  {{.Proof.Tactic}}

-- The state space is exactly as large as the analyzer said.
theorem state_count : reachable.length = {{.Proof.StateCount}} := by {{.Proof.Tactic}}

-- No reachable marking exceeds the analyzer's per-place bounds.
theorem bounded :
    reachable.all (fun m => (m.zip expectedBounds).all (fun p => p.1 ≤ p.2)) = true := by
  {{.Proof.Tactic}}

-- The deadlock set is exactly the analyzer's: same size, and each contains
-- the other. Both lists are duplicate-free (reachable is deduplicated, the
-- expected list is sorted unique), so mutual containment is set equality.
theorem deadlock_count :
    (reachable.filter isDeadlock).length = {{len .Proof.Deadlocks}} := by {{.Proof.Tactic}}

theorem deadlocks_all_expected :
    (reachable.filter isDeadlock).all (expectedDeadlocks.contains ·) = true := by
  {{.Proof.Tactic}}

theorem expected_all_reached :
    expectedDeadlocks.all ((reachable.filter isDeadlock).contains ·) = true := by
  {{.Proof.Tactic}}

-- What remains is a scheduler running on a net the compiler has already
-- checked: fire the first enabled transition (sorted order) until none is.

def render (m : List Nat) : String :=
  String.intercalate "," ((List.range placeNames.length).filterMap fun i =>
    let c := count m i
    let name := placeNames.getD i ""
    if c > 1 then some s!"{name}:{c}"
    else if c > 0 then some name
    else none)

partial def executeProcess (step : Nat) (m : List Nat) : IO Unit := do
  match transitions.find? (enabled m ·) with
  | none => pure ()
  | some t =>
      let next := fire m t
      IO.println s!"Step #{step + 1}: {t.name} => {render next}"
      executeProcess (step + 1) next

def main : IO Unit :=
  executeProcess 0 initialMarking
{{end}}
