/// Canonical marking form: marked places sorted by name, comma-joined,
/// ":count" appended when a place holds more than one token.
pub fn render(m: &Marking) -> String {
    m.iter()
        .filter(|(_, count)| **count > 0)
        .map(|(name, count)| {
            if *count > 1 {
                format!("{}:{}", name, count)
            } else {
                (*name).to_string()
            }
        })
        .collect::<Vec<_>>()
        .join(",")
}

