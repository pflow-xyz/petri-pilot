/// The one generic enablement rule, applied to the data above.
pub fn enabled(m: &Marking, t: &Transition) -> bool {
    t.inputs.iter().all(|(p, w, _)| m[p] >= *w)
        && t.reads.iter().all(|(p, w, _)| m[p] >= *w)
        && t.inhibits.iter().all(|(p, w, _)| m[p] < *w)
        && t.outputs.iter().all(|(p, w, cap)| *cap == 0 || m[p] + w <= *cap)
}

/// Fires t if enabled and reports whether it did.
pub fn fire(m: &mut Marking, t: &Transition) -> bool {
    if !enabled(m, t) {
        return false;
    }
    for (p, w, _) in t.inputs {
        *m.get_mut(p).unwrap() -= w;
    }
    for (p, w, _) in t.outputs {
        *m.get_mut(p).unwrap() += w;
    }
    true
}

/// Canonical marking form: marked places sorted by name, comma-joined,
/// ":count" appended when a place holds more than one token.
pub fn render(m: &Marking) -> String {
    m.iter()
        .filter(|(_, count)| **count > 0)
        .map(|(name, count)| {
            if *count > 1 {
                format!("{}:{}", name, count)
            } else {
                (*name).to_string()
            }
        })
        .collect::<Vec<_>>()
        .join(",")
}

fn main() {
    let mut m = initial_marking();
    let mut step = 0;
    loop {
        let mut fired = false;
        for t in TRANSITIONS.iter() {
            if fire(&mut m, t) {
                step += 1;
                println!("Step #{}: {} => {}", step, t.name, render(&m));
                fired = true;
                break;
            }
        }
        if !fired {
