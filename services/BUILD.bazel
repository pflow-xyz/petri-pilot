load("@io_bazel_rules_go//go:def.bzl", "go_library")

# Exposed so //pkg/codegen/zkgo:zkgo_test and //pkg/runtime/sim:sim_test can
# read them as test data (the tests read the JSON from disk via a relative path
# rather than the embedded copy).
exports_files([
    "coffeeshop.json",
    "tic-tac-toe.json",
    "vet-clinic.json",
])

go_library(
    name = "services",
    srcs = ["embed.go"],
    embedsrcs = [
        "coffeeshop.json",
        "dining-philosophers.json",
        "enzyme-kinetics.json",
        "galton-board.json",
        "hiring-pipeline.json",
        "knapsack.json",
        "loan-approval.json",
        "predator-prey.json",
        "producer-consumer.json",
        "stoplight.json",
        "tcp-handshake.json",
        "texas-holdem.json",
        "thermostat.json",
        "tic-tac-toe.json",
        "bundles/inventory.json",
        "bundles/order.json",
        "bundles/shop.bundle.json",
        "bundles/warehouse.bundle.json",
        "bundles/credit.json",
        "bundles/fulfillment.bundle.json",
        "bundles/cafe-counter.json",
        "bundles/cafe-pantry.json",
        "bundles/cafe.bundle.json",
        "bundles/cafe-staff.json",
        "vet-clinic.json",
    ],
    importpath = "github.com/pflow-xyz/petri-pilot/services",
    visibility = ["//visibility:public"],
)
