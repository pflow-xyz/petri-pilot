{
  "name": "cafe",
  "description": "The coffee shop as three independently-authored nets. The counter runs orders, the pantry holds stock, and staff are the people who can only do one thing at a time.\n\nStarting a drink is one firing of all three: an event link fuses each start_X with the brew_X that pays for it and the acquire_X that takes a barista off the floor, so a drink is never begun without its ingredients being drawn down and someone actually making it. Finishing it is one firing of two — the drink is ready and the barista is free again.\n\nThat is what makes 'what if I put a third barista on?' answerable: headcount is `initial` on staff/available, and the queue it relieves lives in a net that has never heard of staffing.",
  "subnets": [
    {"id": "counter", "net_type": "", "model_ref": "cafe-counter.json"},
    {"id": "pantry", "net_type": "ResourceNet", "model_ref": "cafe-pantry.json"},
    {"id": "staff", "net_type": "ResourceNet", "model_ref": "cafe-staff.json"}
  ],
  "links": [
    {"id": "espresso_started", "kind": "event",
     "from": {"subnet": "counter", "transition": "start_espresso"},
     "to": {"subnet": "pantry", "transition": "brew_espresso"}},
    {"id": "latte_started", "kind": "event",
     "from": {"subnet": "counter", "transition": "start_latte"},
     "to": {"subnet": "pantry", "transition": "brew_latte"}},
    {"id": "cappuccino_started", "kind": "event",
     "from": {"subnet": "counter", "transition": "start_cappuccino"},
     "to": {"subnet": "pantry", "transition": "brew_cappuccino"}},

    {"id": "espresso_started", "kind": "event",
     "from": {"subnet": "counter", "transition": "start_espresso"},
     "to": {"subnet": "staff", "transition": "acquire_espresso"}},
    {"id": "latte_started", "kind": "event",
     "from": {"subnet": "counter", "transition": "start_latte"},
     "to": {"subnet": "staff", "transition": "acquire_latte"}},
    {"id": "cappuccino_started", "kind": "event",
     "from": {"subnet": "counter", "transition": "start_cappuccino"},
     "to": {"subnet": "staff", "transition": "acquire_cappuccino"}},

    {"id": "espresso_finished", "kind": "event",
     "from": {"subnet": "counter", "transition": "finish_espresso"},
     "to": {"subnet": "staff", "transition": "release_espresso"}},
    {"id": "latte_finished", "kind": "event",
     "from": {"subnet": "counter", "transition": "finish_latte"},
     "to": {"subnet": "staff", "transition": "release_latte"}},
    {"id": "cappuccino_finished", "kind": "event",
     "from": {"subnet": "counter", "transition": "finish_cappuccino"},
     "to": {"subnet": "staff", "transition": "release_cappuccino"}}
  ]
}
