{
  "name": "credit",
  "description": "Customer credit standing: unverified <-> cleared",
  "places": [
    {"id": "unverified", "kind": "token", "initial": 1},
    {"id": "cleared", "kind": "token"}
  ],
  "transitions": [
    {"id": "clear_credit", "event": "credit.clear_credit"},
    {"id": "revoke_credit", "event": "credit.revoke_credit"}
  ],
  "arcs": [
    {"from": "unverified", "to": "clear_credit"},
    {"from": "clear_credit", "to": "cleared"},
    {"from": "cleared", "to": "revoke_credit"},
    {"from": "revoke_credit", "to": "unverified"}
  ]
}
