{
  "name": "inventory",
  "description": "Inventory reservation: available <-> reserved",
  "places": [
    {"id": "available", "kind": "token", "initial": 1},
    {"id": "reserved", "kind": "token"}
  ],
  "transitions": [
    {"id": "reserve_stock", "event": "inventory.reserve_stock"},
    {"id": "release", "event": "inventory.release"}
  ],
  "arcs": [
    {"from": "available", "to": "reserve_stock"},
    {"from": "reserve_stock", "to": "reserved"},
    {"from": "reserved", "to": "release"},
    {"from": "release", "to": "available"}
  ]
}
